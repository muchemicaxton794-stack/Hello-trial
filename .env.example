# Copy to .env and fill in. Never commit the real .env.

# Identity shown in the menu and messages
BOT_NAME=bigbrother edition
PREFIX=.

# Full international number, digits only, no "+".
# Leave blank to link by QR code. Set it to link with an 8-character pairing code.
# NOTE: the old default "233000000000" is treated as a placeholder and ignored.
PAIRING_NUMBER=

# Owner of the bot. Owner-only commands (.block, .unblock, .mode, .anticall,
# .addsudo, .delsudo) work only for this number - plus the paired account, which
# is always an owner. Leave blank to restrict those commands to the paired account.
OWNER_NUMBER=

# self   - only owners may run commands (safe default)
# public - anyone may run utility commands; group admin commands still require
#          group admin rights and the bot must itself be a group admin
MODE=self

# Title shown in the .menu header. Kept separate from BOT_NAME so stylised glyphs
# stay out of logs and ordinary replies. Blank = use BOT_NAME.
# The menu is drawn as repeating decorated blocks, one per command category.
MENU_TITLE=𝓓𝓐𝓡𝓚𝓝𝓞𝚃𝙴  Bot

# Optional menu image. Used only when assets/menu.jpg does not exist.
MENU_IMAGE_URL=

# DM sent to the paired number the moment a new device is linked.
# Leave blank to use the built-in copy below, or override it here:
#   "your bot have been paired welcome to darknote L2 by bigbrother where we change your dream to reality"
PAIRING_WELCOME=
